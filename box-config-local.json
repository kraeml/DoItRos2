{
  "variables": {
    "version": "",
    "vagrant_cloud_token": "{{env `VAGRANT_CLOUD_TOKEN`}}"
  },
  "provisioners": [
    {
      "type": "shell",
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "./scripts/ansible.sh"
    },
    {
      "type": "ansible-local",
      "playbook_file": "./shared/main.yml"
    },
    {
      "type": "shell",
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "./scripts/locale-de.sh"
    },
    {
      "type": "ansible-local",
      "playbook_file": "./shared/ros2/main.yml",
      "galaxy_roles_path": "./roles",
      "galaxy_file": "./shared/ros2/requirements.yml"
    },
    {
      "type": "shell",
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "./scripts/cleanup.sh"
    }
  ],
  "builders": [
  {
    "type": "vagrant",
    "source_path": "doitpib/ubuntu-desktop-jammy-de",
    "provider": "virtualbox",
    "communicator": "ssh",
    "output_dir": "./output-vagrant",
    "ssh_username": "vagrant",
    "ssh_password": "vagrant",
    "ssh_timeout": "30m",
    "template": "./Vagrantfile.template",
    "synced_folder": "./"
  }
],
  "post-processors": [
  {
    "type": "shell-local",
    "inline": ["cp ./output-vagrant/package.box ./builds/ubuntu-desktop-jammy-de.box && rm -rf ./output-vagrant"]
  },
  [
    ]
  ]
}
